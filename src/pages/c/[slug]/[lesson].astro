---
import Layout from '../../../layouts/Layout.astro';
import { courses } from '../../../content/courses';
import { siteConfig } from '../../../content/site';
import type { Course, CourseLesson } from '../../../content/courses';

export function getStaticPaths() {
  const paths: { params: { slug: string; lesson: string }; props: { course: Course; lesson: CourseLesson } }[] = [];
  for (const course of courses) {
    for (const lesson of course.lessons) {
      if (lesson.status === 'ready' && lesson.deckPath) {
        paths.push({
          params: { slug: course.slug, lesson: lesson.slug },
          props: { course, lesson },
        });
      }
    }
  }
  return paths;
}

const { course, lesson } = Astro.props;
---

<Layout title={`${lesson.title} - ${course.title}`} description={`${lesson.summary} · ${siteConfig.name}`}>
  <main class="page-shell">
    <section class="section" style="padding-top: 0;">
      <p class="eyebrow">Lesson</p>
      <h1 class="page-title">{lesson.title}</h1>
      <p class="lead">{lesson.summary}</p>
    </section>

    <section class="section" aria-label="课件预览">
      <div class="ppt-viewer">
        <iframe
          id="ppt-frame"
          src={lesson.deckPath}
          title={lesson.title}
          class="ppt-container"
          loading="lazy"
        ></iframe>
        <div class="ppt-nav">
          <button id="btn-prev" class="secondary" onclick="navigatePPT(-1)">← 上一页</button>
          <span id="slide-indicator">加载中...</span>
          <button id="btn-next" onclick="navigatePPT(1)">下一页 →</button>
          <a class="button secondary" href={lesson.deckPath} target="_blank" rel="noopener" style="margin-left: auto;">全屏打开</a>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="button-row" style="margin-top: 0;">
        {lesson.homework && (
          <a class="button-primary" href={`/c/${course.slug}/${lesson.slug}/homework/`}>查看课后作业</a>
        )}
        <a class="button-secondary" href={`/c/${course.slug}/`}>返回课程主页</a>
      </div>
    </section>
  </main>

  <script is:inline>
    const frame = document.getElementById('ppt-frame');
    const btnPrev = document.getElementById('btn-prev');
    const btnNext = document.getElementById('btn-next');
    const indicator = document.getElementById('slide-indicator');

    function syncState() {
      try {
        const win = frame.contentWindow;
        if (!win || typeof win.go !== 'function') return;
        const idx = win.__currentSlideIndex || 0;
        const total = win.total || win.document.querySelectorAll('.slide').length || 0;
        indicator.textContent = total ? `第 ${idx + 1} / ${total} 页` : `第 ${idx + 1} 页`;
        btnPrev.disabled = idx <= 0;
        btnNext.disabled = idx >= total - 1;
      } catch (e) {}
    }

    function navigatePPT(dir) {
      try {
        const win = frame.contentWindow;
        if (win && typeof win.go === 'function') {
          win.go((win.__currentSlideIndex || 0) + dir);
        }
      } catch (e) {}
      setTimeout(syncState, 100);
    }

    frame.addEventListener('load', () => { setTimeout(syncState, 300); });
    setInterval(syncState, 800);
  </script>
</Layout>

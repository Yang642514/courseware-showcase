---
import Layout from '../../../../layouts/Layout.astro';
import { courses } from '../../../../content/courses';
import type { Course, CourseLesson } from '../../../../content/courses';

export function getStaticPaths() {
  const paths: { params: { slug: string; lesson: string }; props: { course: Course; lesson: CourseLesson } }[] = [];
  for (const course of courses) {
    for (const lesson of course.lessons) {
      if (lesson.homework) {
        paths.push({
          params: { slug: course.slug, lesson: lesson.slug },
          props: { course, lesson },
        });
      }
    }
  }
  return paths;
}

const { course, lesson } = Astro.props;
const hw = lesson.homework!;
---

<Layout title={`${hw.title} - ${course.title}`}>
  <main class="page-shell">
    <section class="section" style="padding-top: 0;">
      <p class="eyebrow">Homework</p>
      <h1 class="page-title">{hw.title}</h1>
      <p class="lead">{hw.description}</p>
    </section>

    <section class="section">
      <div class="report-grid">
        <article class="report-cell">
          <span class="tag active">填写格式</span>
          <h2 style="font-size: 22px; margin: 12px 0;">场景卡模板</h2>
          <ul style="color: var(--muted); font-size: 15px; line-height: 2; margin: 0; padding-left: 20px;">
            {hw.fields.map((field) => (
              <li><strong>{field.label}：</strong>{field.description}</li>
            ))}
          </ul>
        </article>

        <article class="report-cell">
          <span class="tag">示例</span>
          <h2 style="font-size: 22px; margin: 12px 0;">{hw.example.title}</h2>
          <ul style="color: var(--muted); font-size: 15px; line-height: 2; margin: 0; padding-left: 20px;">
            {hw.example.fields.map((field) => (
              <li><strong>{field.label}：</strong>{field.value}</li>
            ))}
          </ul>
        </article>
      </div>
    </section>

    <section class="section">
      <article class="report-cell">
        <span class="tag active">可复制</span>
        <h2 style="font-size: 22px; margin: 12px 0;">场景卡模板</h2>
        <pre
          id="template-text"
          style="white-space: pre-wrap; line-height: 2; color: var(--muted); background: var(--surface-muted); padding: 24px; border: 1px solid var(--line); font-size: 14px; overflow-x: auto;"
        >{hw.templateText}</pre>
        <button class="button-primary" id="btn-copy" style="margin-top: 16px;">复制模板</button>
      </article>
    </section>

    <section class="section">
      <div class="button-row" style="margin-top: 0;">
        <a class="button-secondary" href={`/c/${course.slug}/${lesson.slug}/`}>返回课件</a>
        <a class="button-secondary" href={`/c/${course.slug}/`}>返回课程主页</a>
      </div>
    </section>
  </main>

  <script is:inline>
    const templateText = document.getElementById('template-text')?.textContent || '';
    const btnCopy = document.getElementById('btn-copy');
    btnCopy?.addEventListener('click', () => {
      navigator.clipboard.writeText(templateText).then(() => {
        btnCopy.textContent = '已复制 ✓';
        setTimeout(() => { btnCopy.textContent = '复制模板'; }, 2000);
      });
    });
  </script>
</Layout>
